{
  // 아몰랑아일랜드 — Cloudflare 배포 설정
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amollang-island",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [
      { "name": "ISLAND", "class_name": "Island" },
      { "name": "VAULT", "class_name": "Vault" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Island"] },
    { "tag": "v2", "new_sqlite_classes": ["Vault"] }
  ]
}
